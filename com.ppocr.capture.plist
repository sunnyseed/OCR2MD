<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ppocr.capture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/ppocr/.venv/bin/python</string>
        <string>/path/to/ppocr/capture.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/ppocr</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/path/to/ppocr/capture.log</string>

    <key>StandardErrorPath</key>
    <string>/path/to/ppocr/capture.err.log</string>
</dict>
</plist>
