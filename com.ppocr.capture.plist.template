<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板文件。__HOME__ 由 install.sh 替换后写入 ~/Library/LaunchAgents/。
     生成出来的 com.ppocr.capture.plist 已在 .gitignore 里，不要提交。 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ppocr.capture</string>

    <!-- 必须启动 .app 壳而不是裸 python：全局热键权限按“应用身份”记账。
         壳放在 ~/Applications（非 TCC 保护目录），用 launcher.c 编译生成，见 README。 -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/PPOCRCapture.app/Contents/MacOS/ppocr-capture</string>
    </array>

    <!-- Python stdout 在非 TTY 下是块缓冲，常驻进程不退出就永不刷盘，
         会导致 capture.log 一直是 0 字节。关掉缓冲。 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>300</integer>

    <!-- 日志不能放 ~/Documents 等 TCC 保护目录，
         否则 launchd 在程序运行前就打不开日志 fd，spawn 失败报 EX_CONFIG(78)。
         放 ~/Library/Logs/。 -->
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/ppocr/capture.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/ppocr/capture.err.log</string>
</dict>
</plist>
